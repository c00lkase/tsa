pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	pal({[0]=0,1,140,12,2,136,8,128,133,5,134,6,7,9,10,14},1)
	--poke(0x5f2e, 1)
	
	-- add --
	moveable = false
	moveabler = false
	moveablel = false
	moveableb = false
	moveablea = false
	-- end --

	plr = {
		x = 56,
		y = 56,
		w = 8,
		h = 8,
		ox = 0, -- add --
		oy = 0, -- add --
		vx = 0,
		vy = 0,
		s = 1,
		speed = 1.5
	}
	
	-- add --
	gate1 = {
	x = 120,
	y = 55,
	w = 8,
	h = 8,
	}
	
	gate2 = {
	x = 120,
	y = 64,
	w = 8,
	h = 8,
	}
	
	move = {
		x = 30,
		y = 30,
		w = 8,
		h = 8,
		ox = 0,
		oy = 0,
		vx = 0,
		vy = 0,
	}
	
	button = {
		x = 50,
		y = 50,
		w = 6,
		h = 6,
		ox = 0,
		oy = 0,
	}
	
	-- end --
	
	game = {
		bg = 0,
		screenx = 0,
		screeny = 0,
		pause = false,
		transdir = {0, 0}
	}
end

function _update()
 
-- add -- 
checkmove(plr,move)
checkmove(button,move)
switch()
movemoveable()
checkdir()


-- end
	
	
	if not game.pause then
		plrupdate()
	else
		local tdx = game.transdir[1]
		local tdy = game.transdir[2]
		local ogdiffx = 8 * (tdx / abs(tdx))
		local diffx = min(ogdiffx, tdx)
		if tdx != 0 then
			game.transdir[1] -= diffx
			game.screenx += diffx
		else
			game.pause = false
		end
	end
end

function _draw()
	cls(game.bg)
	map(flr(game.screenx/8), flr(game.screeny/8), -game.screenx % 8, -game.screeny % 8)
	spr(68,button.x,button.y)
	spr(plr.s, plr.x - game.screenx, plr.y - game.screeny) -- player --
	-- add --
	 -- moveable rock --
	spr(67,move.x,move.y)
	spr(70,gate1.x,gate1.y)
	spr(70,gate2.x,gate2.y)
	-- end --
	print(plr.y)
end
-->8
-- player --

function pointsoliddetect(x, y, f)
	return fget(mget(x/8, y/8), f)
end

function plrsoliddetect(f)
	local x = plr.x
	local y = plr.y
	local ftl = pointsoliddetect(x, y, f)
	local ftr = pointsoliddetect(x + plr.w - 1, y, f)
	local fbl = pointsoliddetect(x, y + plr.h - 1, f)
	local fbr = pointsoliddetect(x + plr.w - 1, y + plr.h - 1, f)
	
	return ftl or ftr or fbl or fbr
end

function plrxbounds()
	return plr.x < 0 or plr.x + plr.w - 1 > 127
end

function plrybounds()
	return plr.y < 0 or plr.y + plr.h - 1 > 127
end

function round(n)
	local b = n - flr(n)
	if b > 0.5 then
		return ceil(n)
	else
		return flr(n)
	end
end

function plrupdate()
	local lx = flr(plr.x)
	local ly = flr(plr.y)
	
	plr.x = round(plr.x + plr.vx)
	plr.y = round(plr.y + plr.vy)
	
	plr.vx *= 0.6
	plr.vy *= 0.6
	
	local b = {btn(➡️), btn(⬇️), btn(⬅️), btn(⬆️)}
	
	if b[1] then
		plr.s = 1
		plr.vx += 1
	end
	if b[2] then
		plr.s = 4
		plr.vy += 1
	end
	if b[3] then
		plr.s = 3
		plr.vx -= 1
	end
	if b[4] then
		plr.s = 2
		plr.vy -= 1
	end
	
	if b[1] and b[2] then
		plr.s = 8
	end
	if b[2] and b[3] then
		plr.s = 7
	end
	if b[3] and b[4] then
		plr.s = 5
	end
	if b[4] and b[1] then
		plr.s = 6
	end
	
	if plrsoliddetect(0) then
		plr.x = lx
		plr.y = ly
	end
	
	if plrxbounds() and not game.pause then
		if plr.x > 64 then
			game.transdir[1] = game.screenx + 128
		else
			game.transdir[1] = game.screenx - 128
		end
		game.pause = true
	end
end
-->8
-- moveable --

	function checkmove(a, b)
  return a.x + a.ox < b.x + b.w + b.ox and
         a.x + a.ox + a.w > b.x + b.ox and
         a.y + a.oy < b.y + b.h + b.oy and
         a.y + a.oy + a.h > b.y + b.oy
end

function movemoveable()
	if moveabler == true or moveablel == true then
		moveable = true
		move.x = round(move.x + move.vx)
	end
	if moveableb == true or moveablea == true then
		moveable = true
		move.y = round(move.y + move.vy)
	end
		
	if checkmove(plr,move) and moveable == true then
		move.vy = plr.vy
		move.vx = plr.vx
	else
		moveable = false	
	end
	
	if moveable == false then
		move.vy = 0
		move.vx = 0
	end
end


function checkdir()

-- right --
	if plr.s == 1 and plr.x <= move.x and checkmove(plr,move) then
		moveabler = true
	else
		moveabler = false
	end
	
	if moveabler == true and not plr.s == 1 then
		moveabler = false
	end
-- left --
	if plr.s == 3 and plr.x >= move.x and checkmove(plr,move) then
		moveablel = true
	else
		moveablel = false
	end
	
	if moveablel == true and not plr.s == 3 then
	moveablel = false
	end
	
-- below --
	if plr.s == 2 and plr.y >= move.y and checkmove(plr,move) then
		moveableb = true
	else
		moveableb = false
	end
	
	if moveableb == true and not plr.s == 2 then
	 moveableb = false
	end
	
-- above --
	if plr.s == 4 and plr.y <= move.y and checkmove(plr,move) then
		moveablea = true
	else
		moveablea = false
	end
	
	if moveablera == true and not plr.s == 4 then
		moveablea = false
	end
end


function switch()
	if checkmove(button,move) or checkmove(button,plr) then
	gate1.y = 38
	gate2.y = 68
	else
	gate1.y = 55
	gate2.y = 64
	end
 
 
end
