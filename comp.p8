pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main --

function _init()
	pal({[0]=0,1,140,12,2,136,8,128,133,5,134,6,7,9,10,14},1)
	--poke(0x5f2e, 1)
	
	npcs = {}
	
	plr = {
		x = 56,
		y = 56,
		w = 8,
		h = 8,
		vx = 0,
		vy = 0,
		f = 0.6,
		s = 1,
		terminal = 7,
		speed = 1,
		scraps = 0,
	}
	
	game = {
		bg = 0,
		screenx = 0,
		screeny = 0,
		screenanim = false,
		buttondown = {},
		pause = false,
		indialog = false,
		dialogtext = '',
		dialogbegan = 0,
		dialogfinished = false,
		dialogqueue = {},
		targetscreen = {0, 0},
		tick = 0
	}
	
	addnpc(1, 16, 16)
end

function _update()
	if not game.pause then
		game.buttondown = {}
		plrupdate()
		
		npcupdate()
		buttonupdate(plr)
		buttonmapupdate()
		levelupdate()
	else
		if targetscreen != {game.screenx, game.screeny} then
			local tdx = game.targetscreen[1]
			local tdy = game.targetscreen[2]
			
			local xdir = 1
			local ydir = 1
			if tdx < game.screenx then
				xdir = -1
			elseif game.screenx == tdx then
				xdir = 0
			end
			if tdy < game.screeny then
				ydir = -1
			elseif game.screeny == tdy then
				ydir = 0
			end

			local xdiff = xdir * min(4, abs(tdx - game.screenx))
			local ydiff = ydir * min(4, abs(tdy - game.screeny))
			
			game.pause = tdx != game.screenx or tdy != game.screeny
			if game.pause then
				game.screenx += xdiff
				game.screeny += ydiff
			end
		end
	end
	game.tick += 1
	dialogupdate()
end

function _draw()
	cls(game.bg)
	
	local mxcell = flr(game.screenx/8)
	local mycell = flr(game.screeny/8)
	
	map(mxcell, mycell, mxcell * 8 - game.screenx, mycell * 8 - game.screeny)
	spr(plr.s, plr.x - game.screenx, plr.y - game.screeny)
	npcdraw()
	huddraw()
end
