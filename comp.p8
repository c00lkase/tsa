-- player --

function pointsoliddetect(x, y, f)
	local tilex = x/8
	local tiley = y/8
	return fget(mget(tilex, tiley), f)
end

function pointtiledetect(x, y, cx, cy)
	return flr(x / 8) == cx and flr(y / 8) == cy
end

function soliddetect(hitbox, f, f2, it)
	local x = hitbox.x
	local y = hitbox.y
	local w = hitbox.w - 1
	local h = hitbox.h - 1
	ftl = pointsoliddetect(x, y, f)
	ftr = pointsoliddetect(x + w, y, f)
	fbl = pointsoliddetect(x, y + h, f)
	fbr = pointsoliddetect(x + w, y + h, f)
	if it then
		ftl = pointtiledetect(x, y, f, f2)
		ftr = pointtiledetect(x + w, y, f, f2)
		fbl = pointtiledetect(x, y + h, f, f2)
		fbr = pointtiledetect(x + w, y + h, f, f2)
	end
	return ftl or ftr or fbl or fbr
end

function plrxbounds()
	local l = plr.x + plr.w - 1 - game.screenx < 0 or plr.x + plr.w - 1 - game.screenx > 127
	local r = plr.x - game.screenx < 0 or plr.x - game.screenx > 127
	return l and r
end

function plrybounds()
	local l = plr.y + plr.h - 1 - game.screeny < 0 or plr.y + plr.h - 1 - game.screeny > 127
	local r = plr.y - game.screeny < 0 or plr.y - game.screeny > 127
	return l and r
end

function plrmapbounds()
	local maxyrange = 128
	local maxxrange = 256

	return plr.x < 0 or plr.y < 0 or plr.x > maxxrange or plr.y > maxyrange
end

function round(n)
	local b = n - flr(n)
	if b > 0.5 then
		return ceil(n)
	else
		return flr(n)
	end
end

function plrupdate()
	local lx = flr(plr.x)
	local ly = flr(plr.y)
	
	plr.x = round(plr.x + plr.vx)
	plr.y = round(plr.y + plr.vy)
	
	if soliddetect(plr, 0) or plrmapbounds() then
		plr.x = lx
		plr.y = ly
	end
	
	if soliddetect(plr, 1) then
		plr.vx *= -15
		plr.vy *= -15
	end
	
	plr.vx = max(min(plr.terminal, plr.vx * plr.f), -plr.terminal)
	plr.vy = max(min(plr.terminal, plr.vy * plr.f), -plr.terminal)
	
	local b = {btn(➡️), btn(⬇️), btn(⬅️), btn(⬆️)}
	local fxc = false
	
	if b[1] then
		plr.s = 1
		plr.vx += plr.speed
		fxc = true
	end
	if b[2] then
		plr.s = 4
		plr.vy += plr.speed
		fxc = true
	end
	if b[3] then
		plr.s = 3
		plr.vx -= plr.speed
		fxc = true
	end
	if b[4] then
		plr.s = 2
		plr.vy -= plr.speed
		fxc = true
	end
	
	if b[1] and b[2] then
		plr.s = 8
	end
	if b[2] and b[3] then
		plr.s = 7
	end
	if b[3] and b[4] then
		plr.s = 5
	end
	if b[4] and b[1] then
		plr.s = 6
	end
	
	if fxc and rnd(1) > 0.5 and (plr.x % 10 == 0 or plr.y % 10 == 0) then
		addnpc(0, plr.x, plr.y, 24)
	end
	
	if not game.pause then
		if plrxbounds() then
			if plr.x - game.screenx > 64 then
				game.targetscreen[1] = game.screenx + 128
			else
				game.targetscreen[1] = game.screenx - 128
			end
			game.pause = true
		end
		if plrybounds() then
			if plr.y - game.screeny > 64 then
				game.targetscreen[2] = game.screeny + 128
			else
				game.targetscreen[2] = game.screeny - 128
			end
			game.pause = true
		end
	end
end

function plrdir() -- formatted in left, down, right, up
	local l = {3, 5, 7}
	local d = {7, 4, 8}
	local r = {8, 1, 6}
	local u = {2, 5, 6}
	local sprite = plr.s
	
	return {count(l, sprite) > 0, count(d, sprite) > 0, count(r, sprite) > 0, count(u, sprite) > 0}
end
-->8
-- projectiles / sprites --

function addnpc(id, x, y, data)
	if #npcs > 9 then
		return
	end

	local s = 1
	if id == 0 then
		s = 9
	elseif id == 1 then
		s = 68
	end
	
	local npc = {
		id = id,
		s = s,
		x = x,
		y = y,
		vx = 0,
		vy = 0,
		w = 8,
		h = 8,
		d = data
	}

	add(npcs, npc)
end

function pointonscreen(x, y)
	return game.screenx < x and game.screenx + 127 > x and game.screeny < y and game.screeny + 127 > y
end

function npcdraw()
	for i, npc in pairs(npcs) do
		if pointonscreen(npc.x + flr(npc.w / 2), npc.y + flr(npc.h / 2)) then
			spr(npc.s, npc.x - game.screenx, npc.y - game.screeny)
		end
	end
end

function npcupdate()
	for i, npc in pairs(npcs) do
		local id = npc.id
		if id == 0 then
			npc.s = 13 - flr(npc.d / 6)
			npc.d -= 1
		elseif id == 1 then
			npc = moveableupdate(npc)
			buttonupdate(npc)
		end
		if type(npc.d) == 'number' then
			if npc.d < 0 then
				del(npcs, npc)
			end
		end
	end
end
-->8
-- hud --

function dialogdraw(text)
	rectfill(4, 83, 123, 115, 0)
	rect(4, 83, 123, 115, 12)
	fillp(▒)
	rect(6, 85, 121, 113, 9)
	fillp()
	
	strings = {}
	for i = 1, ceil(#text / 27) do
		currindex = i * 27
		currstring = sub(text, currindex - 26, currindex)
		if sub(currstring, 1, 1) == ' ' then
			currstring = sub(currstring, 2, -1)
		end
		add(strings, currstring)
	end
	
	for i, string in pairs(strings) do
		print(string, 10, 81 + 8 * i, 12)
	end
	
	cc = 12
	if btn(🅾️) then
		cc = 10
		sspr(19, 24, 3, 5, 115, 105)
	else
		sspr(16, 24, 3, 5, 115, 105)
	end
	print('🅾️', 107, 105, cc)
end

function dialog(text, o)
	if not game.indialog or o then
		plr.vx *= -1
		plr.vy *= -1
		game.dialogtext = text
		game.dialogbegan = game.tick
		game.indialog = true
	else
		add(game.dialogqueue, text)
	end
end

local ogs = 1
function dialogupdate()
	game.dialogfinished = game.tick - game.dialogbegan > #game.dialogtext
	if game.indialog then
		if plr.speed > 0 then
			ogs = plr.speed
		end
		plr.speed = 0
	else
		plr.speed = ogs
	end
	if game.dialogfinished and btn(🅾️) then
		if #game.dialogqueue > 0 then
			dialog(game.dialogqueue[1], true)
			deli(game.dialogqueue, 1)
		else
			game.indialog = false
		end
	end
end

function huddraw()
	local trans = game.tick % 4
	local patts = {0b1110101111101011.1, 0b1101011111010111.1, 0b1011111010111110.1, 0b011111010111101.1}
	fillp(patts[trans + 1])
	rectfill(0, 119, 128, 128, 0)
	spr(48, 54, 120)
	spr(49, 61, 120)
	print(plr.scraps, 68, 121, 12)
	fillp()
	
	if game.indialog then
		dialogdraw(sub(game.dialogtext, 0, game.tick - game.dialogbegan))
	end
end
-->8
-- moveable --

function hitboxcheck(a, b)
 return a.x < b.x + b.w and
        a.x + a.w > b.x and
        a.y < b.y + b.h and
        a.y + a.h > b.y
end

function moveableupdate(move)
	local direction = plrdir()

	local plrmovecollide = hitboxcheck(plr, move)
	local moveablel = direction[1] and plr.x >= move.x and plrmovecollide
	local moveabler = direction[3] and plr.x <= move.x + 2 and plrmovecollide
	local moveablea = direction[4] and plr.y <= move.y + move.h - 1 and plrmovecollide
	local moveableb = direction[2] and plr.y >= move.y - move.h + 1 and plrmovecollide
	local moveable = moveablel or moveabler or moveablea or moveableb
	
	local lx = move.x
	local ly = move.y
		
	if moveable then
		move.vy = plr.vy
		move.vx = plr.vx	
	end 
	
	move.x = round(move.x + move.vx)
	move.y = round(move.y + move.vy)
	if ((not moveable) and not plrmovecollide)  or soliddetect(move, 0) or soliddetect(move, 1) then
		move.vy = 0
		move.vx = 0
		
		move.x = lx
		move.y = ly
	end
	
	return move
end

function c2i(x, y)
	return x + y * 128
end

function isbuttondown(id)
	return count(game.buttondown, id) > 0
end

function buttonupdate(npc)
	local bx = flr(game.screenx / 8)
	local by = flr(game.screeny / 8)
	
	for y=by, by + 15 do
		for x=bx, bx + 15 do
			local tile = mget(x, y)
			local collide = soliddetect(npc, x, y, true)
			
			if count(game.buttondown, c2i(x, y)) < 1 then
				if collide and (tile == 85 or tile == 86) then
					add(game.buttondown, c2i(x, y))
				end
			end
		end
	end
end

function buttonmapupdate()
	local bx = flr(game.screenx / 8)
	local by = flr(game.screeny / 8)
	
	for y=by, by + 15 do
		for x=bx, bx + 15 do
			local tile = mget(x, y)
			local id = c2i(x, y)
			
			if tile == 85 or tile == 86 then
				if count(game.buttondown, id) > 0 then
					mset(x, y, 86)
				else
					mset(x, y, 85)
				end
			end
		end
	end
end
-->8
-- levels --

function enterance(x, y, w, h, closed)
	w -= 1
	h -= 1
	for nx = x, x + w do
		for ny = y, y + h do
			local bx = nx == x
			local by = ny == y
			local ex = nx == x + w
			local ey = ny == y + h
						
			local ground = 64
			if ny % 2 == 0 then
				ground = 65
			end
			
			if not closed then
				if by then
					if bx then
						mset(nx, ny, 112)
					elseif ex then
						mset(nx, ny, 113)
					else
						mset(nx, ny, 83)
					end
				elseif ey then
					if bx then
						mset(nx, ny, 96)
					elseif ex then
						mset(nx, ny, 97)
					else
						mset(nx, ny, 115)
					end
				else
					mset(nx, ny, ground)
				end
			else
				if bx then
					mset(nx, ny, 100)
				elseif ex then
					mset(nx, ny, 98)
				else
					mset(nx, ny, 0)
				end
			end
		end
	end
end

function levelupdate()
	if game.screenx == 0 then
		enterance(15, 5, 2, 5, not isbuttondown(519))
		if isbuttondown(519) then
			--dialog('dialog test')
		end
	end
end
