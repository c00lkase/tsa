pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	pal({[0]=0,1,140,12,2,136,8,128,133,5,134,6,7,9,10,14},1)
	--poke(0x5f2e, 1)
	
	npcs = {}
	
	plr = {
		x = 56,
		y = 56,
		w = 8,
		h = 8,
		vx = 0,
		vy = 0,
		f = 0.6,
		s = 1,
		terminal = 7,
		speed = 1,
		scraps = 0,
	}
	
	game = {
		bg = 0,
		screenx = 0,
		screeny = 0,
		screenanim = false,
		pause = false,
		targetscreen = {0, 0},
		tick = 0
	}
	
	addnpc(1, 16, 16)
end

function _update()
	if not game.pause then
		plrupdate()
		npcupdate()
		game.tick += 1
	else
		if targetscreen != {game.screenx, game.screeny} then
			local tdx = game.targetscreen[1]
			local tdy = game.targetscreen[2]
			
			local xdir = 1
			local ydir = 1
			if tdx < game.screenx then
				xdir = -1
			elseif game.screenx == tdx then
				xdir = 0
			end
			if tdy < game.screeny then
				ydir = -1
			elseif game.screeny == tdy then
				ydir = 0
			end

			local xdiff = xdir * min(4, abs(tdx - game.screenx))
			local ydiff = ydir * min(4, abs(tdy - game.screeny))
			
			game.pause = tdx != game.screenx or tdy != game.screeny
			if game.pause then
				game.screenx += xdiff
				game.screeny += ydiff
			end
		end
	end
end

function _draw()
	cls(game.bg)
	
	local mxcell = flr(game.screenx/8)
	local mycell = flr(game.screeny/8)
	
	map(mxcell, mycell, mxcell * 8 - game.screenx, mycell * 8 - game.screeny)
	spr(plr.s, plr.x - game.screenx, plr.y - game.screeny)
	npcdraw()
	huddraw()
end
-->8
-- player --

function pointsoliddetect(x, y, f)
	return fget(mget(x/8, y/8), f)
end

function soliddetect(hitbox, f)
	local x = hitbox.x
	local y = hitbox.y
	local ftl = pointsoliddetect(x, y, f)
	local ftr = pointsoliddetect(x + hitbox.w - 1, y, f)
	local fbl = pointsoliddetect(x, y + plr.h - 1, f)
	local fbr = pointsoliddetect(x + hitbox.w - 1, y + hitbox.h - 1, f)
	
	return ftl or ftr or fbl or fbr
end

function plrxbounds()
	local l = plr.x + plr.w - 1 - game.screenx < 0 or plr.x + plr.w - 1 - game.screenx > 127
	local r = plr.x - game.screenx < 0 or plr.x - game.screenx > 127
	return l and r
end

function plrybounds()
	local l = plr.y + plr.h - 1 - game.screeny < 0 or plr.y + plr.h - 1 - game.screeny > 127
	local r = plr.y - game.screeny < 0 or plr.y - game.screeny > 127
	return l and r
end

function plrmapbounds()
	local maxyrange = 128
	local maxxrange = 256

	return plr.x < 0 or plr.y < 0 or plr.x > maxxrange or plr.y > maxyrange
end

function round(n)
	local b = n - flr(n)
	if b > 0.5 then
		return ceil(n)
	else
		return flr(n)
	end
end

function plrupdate()
	local lx = flr(plr.x)
	local ly = flr(plr.y)
	
	plr.x = round(plr.x + plr.vx)
	plr.y = round(plr.y + plr.vy)
	
	if soliddetect(plr, 0) or plrmapbounds() then
		plr.x = lx
		plr.y = ly
	end
	
	if soliddetect(plr, 1) then
		plr.vx *= -15
		plr.vy *= -15
	end
	
	plr.vx = min(plr.terminal, plr.vx * plr.f)
	plr.vy = min(plr.terminal, plr.vy * plr.f)
	
	local b = {btn(➡️), btn(⬇️), btn(⬅️), btn(⬆️)}
	local fxc = false
	
	if b[1] then
		plr.s = 1
		plr.vx += plr.speed
		fxc = true
	end
	if b[2] then
		plr.s = 4
		plr.vy += plr.speed
		fxc = true
	end
	if b[3] then
		plr.s = 3
		plr.vx -= plr.speed
		fxc = true
	end
	if b[4] then
		plr.s = 2
		plr.vy -= plr.speed
		fxc = true
	end
	
	if b[1] and b[2] then
		plr.s = 8
	end
	if b[2] and b[3] then
		plr.s = 7
	end
	if b[3] and b[4] then
		plr.s = 5
	end
	if b[4] and b[1] then
		plr.s = 6
	end
	
	if fxc and rnd(1) > 0.5 and (plr.x % 10 == 0 or plr.y % 10 == 0) then
		addnpc(0, plr.x, plr.y, 24)
	end
	
	if not game.pause then
		if plrxbounds() then
			if plr.x - game.screenx > 64 then
				game.targetscreen[1] = game.screenx + 128
			else
				game.targetscreen[1] = game.screenx - 128
			end
			game.pause = true
		end
		if plrybounds() then
			if plr.y - game.screeny > 64 then
				game.targetscreen[2] = game.screeny + 128
			else
				game.targetscreen[2] = game.screeny - 128
			end
			game.pause = true
		end
	end
end

function plrdir() -- formatted in left, down, right, up
	local l = {3, 5, 7}
	local d = {7, 4, 8}
	local r = {8, 1, 6}
	local u = {2, 5, 6}
	local sprite = plr.s
	
	return {count(l, sprite) > 0, count(d, sprite) > 0, count(r, sprite) > 0, count(u, sprite) > 0}
end
-->8
-- projectiles / sprites --

function addnpc(id, x, y, data)
	if #npcs > 9 then
		return
	end

	local s = 1
	if id == 0 then
		s = 9
	elseif id == 1 then
		s = 68
	end
	
	local npc = {
		id = id,
		s = s,
		x = x,
		y = y,
		d = data
	}
	
	if id == 1 then
		npc.w = 8
		npc.h = 8
	end
	add(npcs, npc)
end

function npcdraw()
	for i, npc in pairs(npcs) do
		spr(npc.s, npc.x - game.screenx, npc.y - game.screeny)
	end
end

function npcupdate()
	for i, npc in pairs(npcs) do
		local id = npc.id
		if id == 0 then
			npc.s = 13 - flr(npc.d / 6)
			npc.d -= 1
		elseif id == 1 then
			npc = moveableupdate(npc)
		end
		if type(npc.d) == 'number' then
			if npc.d < 0 then
				del(npcs, npc)
			end
		end
	end
end
-->8
-- hud --

function huddraw()
	local trans = game.tick % 4
	local patts = {0b1110101111101011.1, 0b1101011111010111.1, 0b1011111010111110.1, 0b011111010111101.1}
	fillp(patts[trans + 1])
	rectfill(0, 119, 128, 128, 0)
	spr(48, 54, 120)
	spr(49, 61, 120)
	print(plr.scraps, 68, 121, 12)
end
-->8
-- moveable --

function hitboxcheck(a, b)
 return a.x < b.x + b.w and
        a.x + a.w > b.x and
        a.y < b.y + b.h and
        a.y + a.h > b.y
end

function moveableupdate(move)
	local direction = plrdir()

	local moveablel = direction[1] and plr.x >= move.x - 1 and hitboxcheck(plr, move)
	local moveabler = direction[3] and plr.x <= move.x and hitboxcheck(plr, move)
	local moveablea = direction[4] and plr.y <= move.y + move.h and hitboxcheck(plr, move)
	local moveableb = direction[2] and plr.y >= move.y - move.h and hitboxcheck(plr, move)
	
	local lx = move.x
	local ly = move.y
	
	if moveabler or moveablel then
		moveable = true
		move.x = round(move.x + move.vx)
	end
	
	if moveableb or moveablea then
		moveable = true
		move.y = round(move.y + move.vy)
	end
		
	if hitboxcheck(plr,move) and moveable then
		move.vy = plr.vy
		move.vx = plr.vx
	else
		moveable = false	
	end 
	
	if not moveable or soliddetect(move, 0) or soliddetect(move, 1) then
		move.vy = 0
		move.vx = 0
		
		move.x = lx
		move.y = ly
	end
	
	return move
end
